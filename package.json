{
  "name": "@fuzdev/fuz_schema",
  "version": "0.1.0",
  "description": "a performance-focused Standard Schema library for JS",
  "logo": "logo.svg",
  "logo_alt": "a friendly pixelated spider facing you",
  "license": "MIT",
  "homepage": "https://schema.fuz.dev/",
  "author": {
    "name": "Ryan Atkinson",
    "email": "mail@ryanatkn.com",
    "url": "https://www.ryanatkn.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuzdev/fuz_schema.git"
  },
  "bugs": "https://github.com/fuzdev/fuz_schema/issues",
  "funding": "https://www.ryanatkn.com/funding",
  "scripts": {
    "start": "gro dev",
    "dev": "gro dev",
    "build": "gro build",
    "check": "gro check",
    "test": "gro test",
    "preview": "vite preview",
    "deploy": "gro deploy",
    "benchmark": "gro run src/benchmarks/run.ts",
    "benchmark:bundle": "gro run src/benchmarks/bundle.ts",
    "benchmark:allocations": "node --min-semi-space-size=64 --max-semi-space-size=64 src/benchmarks/allocations.ts",
    "benchmark:types": "gro run src/benchmarks/types.ts",
    "benchmark:coldstart": "gro run src/benchmarks/run_coldstart.ts",
    "benchmark:heap": "gro run src/benchmarks/run_heap.ts",
    "benchmark:wasm": "node src/benchmarks/wasm.ts",
    "benchmark:harvest": "node --min-semi-space-size=64 --max-semi-space-size=64 src/benchmarks/harvest.ts",
    "build:wasm": "wasm-pack build crates/fuz_schema_wasm --target web --release --out-dir ../../target/fuz_schema_wasm",
    "grade": "node src/benchmarks/grade.ts"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#routes/*": "./src/routes/*"
  },
  "engines": {
    "node": ">=24.14"
  },
  "keywords": [
    "schema",
    "validation",
    "standard-schema",
    "typescript",
    "js"
  ],
  "devDependencies": {
    "@fuzdev/blake3-wasm": "^0.2.0",
    "@fuzdev/fuz_code": "^0.52.1",
    "@fuzdev/fuz_css": "^0.66.1",
    "@fuzdev/fuz_ui": "^0.213.0",
    "@fuzdev/fuz_util": "^0.72.0",
    "@fuzdev/gro": "^0.216.0",
    "@fuzdev/mdz": "^0.4.0",
    "@ryanatkn/eslint-config": "^0.13.0",
    "@sveltejs/acorn-typescript": "^1.0.10",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/estree": "^1.0.8",
    "@types/node": "^24.12.4",
    "@webref/css": "^8.2.0",
    "arktype": "^2.2.8",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.13.1",
    "esm-env": "^1.2.2",
    "magic-string": "^0.30.21",
    "rolldown": "^1.2.13",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-docinfo": "^0.9.0",
    "svelte2tsx": "^0.7.56",
    "tslib": "^2.8.1",
    "typebox": "^1.3.36",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "valibot": "^1.5.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.0",
    "zimmerframe": "^1.1.4",
    "zod": "^4.3.6"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/lib/**/*.ts",
    "!src/lib/**/*.test.*",
    "!dist/**/*.test.*"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.ts": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  }
}
